# --- Research World data & artifacts (never commit datasets or trained models) ---
# Written as `datasets/*` rather than `datasets/` (same reasoning as artifacts/ below):
# git does not descend into an excluded directory, so a `!` negation inside one would
# never match. The large third-party training datasets (student_stress_factors.csv,
# dreaddit-*.csv) stay ignored via this wildcard; local_validation/ is explicitly
# un-ignored below because it is small, locally-collected, consented survey data that
# is normal to include as dissertation supporting evidence, unlike the bulk training data.
ml_pipeline/datasets/*
!ml_pipeline/datasets/local_validation/
!ml_pipeline/datasets/local_validation/**

# Artifacts: ignore the contents (trained model binaries), but keep the small
# JSON metadata tracked — feature_schema.json is the backend's inference
# contract, and artifact_manifest.json is the committed record of which model
# binary was produced, when, and from which dataset hash. Written as
# `artifacts/*` rather than `artifacts/` because git does not descend into an
# excluded directory, so a `!` negation inside one would never match.
ml_pipeline/artifacts/*
!ml_pipeline/artifacts/feature_schema.json
!ml_pipeline/artifacts/artifact_manifest.json
!ml_pipeline/artifacts/shap_config.json

*.pkl

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Logs ---
*.log
