# Copy to backend/.env and fill in real values. Never commit backend/.env.

# PostgreSQL connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://innersync:CHANGE_ME@localhost:5432/innersync

# JWT signing key. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Research World artifacts (defaults to <repo>/ml_pipeline/artifacts)
# ARTIFACTS_DIR=
MODEL_FILENAME=stress_model_v2.pkl

# Gemini API key for the chatbot (Module 3). Get one at
# https://aistudio.google.com/apikey. Optional at process startup — the rest
# of the app runs fine without it — but every /chat/* request fails with a
# clear 503 until this is set. Never committed; never given a fallback value.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Resend API key for password reset emails. Get one at
# https://resend.com/api-keys. Optional at process startup -- only
# /auth/forgot-password needs it, and fails with a clear 503 if unset.
RESEND_API_KEY=
# RESEND_FROM_EMAIL="InnerSync AI <onboarding@resend.dev>"
# FRONTEND_BASE_URL=http://127.0.0.1:5173
